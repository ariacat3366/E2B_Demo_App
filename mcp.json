{
  "clients": [
    {
      "name": "github",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github"
        ]
      },
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${MCP_GITHUB_PAT}",
        "GITHUB_DEFAULT_REPOSITORY": "${MCP_GITHUB_REPOSITORY:-owner/repo}"
      },
      "description": "Read/write GitHub resources via MCP."
    }
  ]
}

